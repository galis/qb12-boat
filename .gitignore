# 视频太大，不进 Git；版本靠 outputs/MEDIA_MANIFEST.md 里的 md5 记录
*.mp4
*.mov
*.wav
*.flac
# 构建缓存、临时文件
__pycache__/
*.pyc
.DS_Store
node_modules/
**/build/
**/_shots/
**/_preview*.html
**/_build_*.html
*.tmp

# 本仓库自己的 Python 环境和大模型
.venv/
.venv-kicad/
video/dl/

# KiCad 10 3D 导出的中间文件（成品拷到 outputs/）
hardware/pcb/out/3d/
viewer/pcb_preview.glb
hardware/pcb/pkg/*.zip
video/_xfer/
# 视频工具每集的中间产物（配音、时间轴、渲染分段在 build/，质检报告和截帧在 qc/）
video/**/qc/
video/**/_status.txt

# 固件
firmware/.arduino/
firmware/build/

# HyperFrames 每集的缓存、配音分段、质检截帧、渲染日志（都能重新生成）
video/**/.media/
video/**/.check/
video/**/.hyperframes/
video/**/render_split.log
# Noto CJK 字体单个 16 MB，从 video-gen skill 的 assets/fonts 拷
video/boardcheck/**/fonts/
# QB12_KiCad工程.zip 已经在库里，解压出来的目录不重复进库
outputs/QB12/QB12_KiCad/
video/firmware/**/fonts/
video/firmware/**/.media/
video/firmware/**/renders/
video/firmware/**/.check/

# Claude Code 本机设置，不进库
.claude/
# 第三方网页抓取（PCB 课写稿参考），有版权，只留本机
courses/pcb/raw/
# make_pkg.sh 生成，成品是 outputs/QB12/QB12_KiCad工程.zip
hardware/pcb/pkg/QB12_KiCad/
# gen_*.py 生成后拷到 outputs/QB12/，这里不重复进库
viewer/QB12_*.html
