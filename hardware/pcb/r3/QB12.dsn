    (class kicad_default AIN1 AIN2 BAT_SW BIN1 BIN2 BOOT CC1 CC2 CHRG EN LED1_A
      LED2_A LED3_A LED_STAT PROG PWR_EN_N STDBY USB_DET USB_DN USB_DP VBAT_ADC
      VCP VINT nFAULT nSLEEP
      (circuit
